# SFTPGo configuration for Keeper (drakkan/sftpgo:v2.7.6), loaded by compose
# via env_file. Each variable overrides one key of the image's
# /etc/sftpgo/sftpgo.json: SFTPGO_<SECTION>__<KEY>, list items by index.
# Users, the event action and the event rule come from initial-data.json
# (see entrypoint.sh), so nothing has to be clicked in a web UI.

# Plain FTP for the camera, on the compose network only. Passive data ports
# are only reached container-to-container, so they are not published. An
# empty force_passive_ip makes SFTPGo advertise the address the client
# connected to (the container's own IP).
SFTPGO_FTPD__BINDINGS__0__PORT=21
SFTPGO_FTPD__PASSIVE_PORT_RANGE__START=50000
SFTPGO_FTPD__PASSIVE_PORT_RANGE__END=50009

# Nothing but FTP: no SFTP, no WebDAV, no web admin / REST API (no admin
# account exists either, so there is nothing to log in to).
SFTPGO_SFTPD__BINDINGS__0__PORT=0
SFTPGO_HTTPD__BINDINGS__0__PORT=0

# Health endpoint for `sftpgo ping` (compose healthcheck), container-local.
SFTPGO_TELEMETRY__BIND_PORT=10000
SFTPGO_TELEMETRY__BIND_ADDRESS=127.0.0.1

# The process runs as uid/gid 1000 (the image default), so every upload is
# owned by 1000:1000. umask 022 gives 0644 files and 0755 dirs: readable by
# every Keeper service (all uid 1000). setstat_mode=1 ignores chmod/chown/
# mtime requests from the client, so a camera cannot change that.
SFTPGO_COMMON__UMASK=022
SFTPGO_COMMON__SETSTAT_MODE=1

# Users and rules live in memory: the memory provider loads the rendered
# dump (entrypoint.sh) at every start, so the files in git are the only
# source of truth and there is no SFTPGo state to keep.
SFTPGO_DATA_PROVIDER__DRIVER=memory
SFTPGO_DATA_PROVIDER__NAME=/tmp/keeper-initial-data.json

SFTPGO_LOG_LEVEL=info
