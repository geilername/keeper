# Copy to .env and fill in. Never commit .env.

# Dash0 (use a dedicated demo dataset). Endpoint is the OTLP/HTTP endpoint
# for your region, e.g. https://ingress.eu-west-1.aws.dash0.com
DASH0_ENDPOINT=
DASH0_AUTH_TOKEN=
DASH0_DATASET=keeper-demo

# Dash0 deep link for the console's "Open trace in Dash0" button. The gateway
# fills {dash0_state} with the trace explorer's view of the photo's trace
# (dataset from DASH0_DATASET, waterfall open on the photo's root span).
# Put your organization ID in place of <org-id>: it is the org= value in the
# address bar of any Dash0 page. Other placeholders: {trace_id}, {span_id}.
# See observability/README.md.
DASH0_TRACE_URL=https://app.dash0.com/traces/explorer?org=<org-id>&s={dash0_state}

# FTP password of the camera user in SFTPGo (demo only).
CAMERA_FTP_PASSWORD=camera

# Lightroom target: mock (default, fault injection) or adobe (optional).
LIGHTROOM_MODE=mock
# Adobe Developer Console, OAuth Web App credential (see docs/architecture.md).
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_REDIRECT_URI=https://localhost:8443/auth/lightroom/callback
# Seals Lightroom tokens at rest: openssl rand -base64 32
# KEEPER_TOKEN_KEY=

# Collector debug exporter: basic | normal | detailed
COLLECTOR_DEBUG_VERBOSITY=basic
